# Local settings; copy to .env and adjust as needed.
BRUZ_DATABASE_PATH=./data/bruz.db
BRUZ_DATA_DIR=./data
BRUZ_MAX_DOCUMENT_BYTES=104857600
BRUZ_MAX_PAGES=100
BRUZ_MAX_PAGE_PIXELS=50000000
BRUZ_QUALITY_SAMPLE_MAX_SIDE=1600
BRUZ_QUALITY_BLUR_FAIL=10
BRUZ_QUALITY_BLUR_WARN=60
BRUZ_QUALITY_FAIL_WIDTH=400
BRUZ_QUALITY_FAIL_HEIGHT=400
BRUZ_QUALITY_MIN_WIDTH=1000
BRUZ_QUALITY_MIN_HEIGHT=1000
BRUZ_QUALITY_BRIGHTNESS_FAIL_LOW=30
BRUZ_QUALITY_BRIGHTNESS_LOW=70
BRUZ_QUALITY_BRIGHTNESS_HIGH=250
BRUZ_QUALITY_BRIGHTNESS_FAIL_HIGH=254
BRUZ_QUALITY_CONTRAST_FAIL=8
BRUZ_QUALITY_CONTRAST_MIN=25
BRUZ_QUALITY_EDGE_MARGIN_RATIO=0.02
BRUZ_QUALITY_EDGE_DENSITY_WARN=0.12
BRUZ_QUALITY_FOREGROUND_CUTOFF=180
BRUZ_HOST=127.0.0.1
BRUZ_PORT=8787
BRUZ_DEBUG=false
